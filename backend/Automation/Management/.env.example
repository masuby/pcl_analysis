# Copy to ".env" and fill in. App passwords: spaces are OK — they are stripped for SMTP.
#
# EMAIL_USERNAME=you@platinumcredit.co.tz
# APP_PASSWORD=xxxx xxxx xxxx xxxx
#
# Optional (defaults: Gmail SMTP):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
#
# When you answer "N" to "Send to all managers", email goes here:
# DEVELOPER_EMAIL=you@platinumcredit.co.tz
#
# Aliases also read if APP_PASSWORD unset:
# EMAIL_PASSWORD=...
# app_password=...
# MANAGEMENT_EMAIL / MANAGEMENT_EMAIL_PASSWORD
