# AI Sales Manager — environment (key NAMES only; put real values in .env, never commit)
#
# The service loads, in order:
#   1) $AISM_ENV_FILE if set
#   2) ./ai_sales_manager/.env
#   3) the existing DataDashboard/.env (which already holds your keys)
#
# So you can just point it at the DataDashboard/.env:
#   set AISM_ENV_FILE=...\src\pages\Dashboard\components\DataDashboard\.env   (Windows)
#   export AISM_ENV_FILE=.../DataDashboard/.env                              (bash)

# ── LLM providers (first available per tier is used) ────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=

# ── Tools ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./sales-reps-status-7475ee1cd190.json

# ── LangSmith tracing (LangChain auto-traces when these are set) ────────────
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-sales-manager
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ── Guards / behaviour ──────────────────────────────────────────────────────
DAILY_TOKEN_LIMIT=200000
# Human email to SHARE the auto-created Leads sheet with (so you can view it).
AISM_LEADS_OWNER_EMAIL=
# Reuse an existing Leads spreadsheet instead of creating one (optional).
AISM_LEADS_SHEET_ID=
